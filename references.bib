@article{henselDiffractionMinimaResolve2025,
  title = {Diffraction Minima Resolve Point Scatterers at Few Hundredths of the Wavelength},
  author = {Hensel, Thomas A. and Wirth, Jan O. and Schwarz, Ole L. and Hell, Stefan W.},
  date = {2025-03},
  journaltitle = {Nature Physics},
  shortjournal = {Nat. Phys.},
  volume = {21},
  number = {3},
  pages = {412--420},
  issn = {1745-2473, 1745-2481},
  doi = {10.1038/s41567-024-02760-1},
  url = {https://www.nature.com/articles/s41567-024-02760-1},
  urldate = {2026-08-26},
  abstract = {Abstract             Resolving two or more constantly scattering identical point sources using freely propagating waves is limited by diffraction. Here we show that, by illuminating with a diffraction minimum, a given number of point scatterers can be resolved at distances of small fractions of the wavelength. Specifically, we identify an 8\,nm distance, which corresponds to 1/80 of the employed 640\,nm wavelength, between two constantly emitting fluorescent molecules in the focal plane of an optical microscope. We also measure 22\,nm side length for a quadratic array of four molecules. Moreover, we show that the measurement precision improves with decreasing distance and with increased scatterer density. This work opens up the prospect of resolving individual scatterers in clusters that are far smaller than the wavelength.},
  langid = {english},
  file = {C:\Users\Parzival1401\Zotero\storage\X8MZZ224\Hensel et al. - 2025 - Diffraction minima resolve point scatterers at few hundredths of the wavelength.pdf}
}

@online{lopezOpensourceSubNanometerStabilization2025,
  title = {Open-Source {{Sub-Nanometer Stabilization System}} for {{Super}}-Resolution {{Fluorescence Microscopy}}},
  author = {Lopez, Lucía and Edorna, Florencia and Choque, Florencia Daniela and Ferrari, Giovanni and Masullo, Luciano Andres and Acuna, Guillermo and Tinnefeld, Philip and Szalai, Alan Marcelo and Zdańkowski, Piotr and Zelcer, Andrés and Stefani, Fernando},
  date = {2025-04-17},
  eprinttype = {In Review},
  doi = {10.21203/rs.3.rs-6131181/v1},
  url = {https://www.researchsquare.com/article/rs-6131181/v1},
  urldate = {2026-08-26},
  abstract = {Abstract           Recent advances in fluorescence nanoscopy have pushed resolution to the 1-10 nm range, enabling the direct visualization of individual molecules even in crowded biological environments. Achieving this level of precision requires rigorous sample drift control. Techniques such as MINFLUX and RASTMIN, which rely on keeping the sample fixed within an excitation pattern, demand active drift correction to achieve their theoretical nanometer-scale resolution limits. Here, we present an active stabilization system for super-resolution microscopy that delivers sub-nm precision for hours. Featuring a simple optical design, the system can be added as a separate module to any fluorescence microscope. We also provide an open-source control software including a user-friendly graphical interface readily adaptable to different setups. We demonstrate the adaptability and performance of the stabilization system with p-MINFLUX and RASTMIN measurements performed in two different setups reaching the theoretical Cramér-Rao Bound and resolving \textasciitilde 10 nm distances within DNA origami structures.},
  langid = {english},
  pubstate = {prepublished},
  file = {C:\Users\Parzival1401\Zotero\storage\I9TZEJBW\Lopez et al. - 2025 - Open-source Sub-Nanometer Stabilization System for Super-resolution Fluorescence Microscopy.pdf}
}

@article{lopezOptimizationCharacterizationToroidal2023,
