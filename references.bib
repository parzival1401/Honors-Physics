@article{stallingaAbsorptionDipoleEffects2026,
  title = {Absorption Dipole Effects on {{MINFLUX}} Single Molecule Localization},
  author = {Stallinga, Sjoerd and Wang, Wenxiu and Rieger, Bernd},
