# ---------------------------------------------------------------------------
# Polarization dependence of the deflection sensitivity (apr10 dataset)
# ---------------------------------------------------------------------------
# Four graphs per deflector, named by amplifier: HVA1 drives EOD34, HVA2 drives
# EOD35 (confirmed 2026-10-26; see the naming table in PROVENANCE.md).
eod-polarization-hva1-radial.png      HVA1_polarization_radial.png
eod-polarization-hva1-cx.png          HVA1_polarization_cx.png
eod-polarization-hva1-cy.png          HVA1_polarization_cy.png
eod-polarization-hva1-mrad-per-kv.png HVA1_polarization_mrad_per_kV.png
eod-polarization-hva2-radial.png      HVA2_polarization_radial.png
eod-polarization-hva2-cx.png          HVA2_polarization_cx.png
eod-polarization-hva2-cy.png          HVA2_polarization_cy.png
eod-polarization-hva2-mrad-per-kv.png HVA2_polarization_mrad_per_kV.png

# ---------------------------------------------------------------------------
# Beam quality against drive voltage (mar_25 angle dataset)
# ---------------------------------------------------------------------------
# These four source names are generic — a bare ordinal and a metric. They are
# unique only because one source root holds them. If another dataset directory
# with the same naming is ever added to SOURCE_ROOTS, the newest-match rule
# will silently pick across datasets; rename at the source if that happens.
eod-quality-voltage-fwhm.png          1_fwhm.png
eod-quality-voltage-ellipticity.png   2_ellipticity.png
eod-quality-voltage-r2.png            3_r2.png
eod-quality-voltage-omega.png         4_omega.png

# ---------------------------------------------------------------------------
# Pointing stability at held drive voltages (angle_stability/apr_4)
# ---------------------------------------------------------------------------
# Sources say EOD1/EOD2: EOD1 = HVA1 = EOD34, EOD2 = HVA2 = EOD35. Stable names
# use the serial. Lever arm 380 mm (350 mm bench distance + 30 mm to the
# crystal centre; a different bench from the polarization one). These source
# names are generic and unique only within apr_4; the ODE*_ files beside them
# are old diagnostics and must not be matched.
eod-stab-eod34-timeseries-m10v.png    EOD1_timeseries_m10V.png
eod-stab-eod34-timeseries-0v.png      EOD1_timeseries_0V.png
eod-stab-eod34-timeseries-p10v.png    EOD1_timeseries_p10V.png
eod-stab-eod35-timeseries-m10v.png    EOD2_timeseries_m10V.png
eod-stab-eod35-timeseries-0v.png      EOD2_timeseries_0V.png
eod-stab-eod35-timeseries-p10v.png    EOD2_timeseries_p10V.png
eod-stab-eod34-std.png                EOD1_stability_std_vs_voltage.png
eod-stab-eod34-p2p.png                EOD1_stability_p2p_vs_voltage.png
eod-stab-eod35-std.png                EOD2_stability_std_vs_voltage.png
eod-stab-eod35-p2p.png                EOD2_stability_p2p_vs_voltage.png
eod-stab-eod34-angular.png            EOD1_boxplot_angular_mrad.png
eod-stab-eod35-angular.png            EOD2_boxplot_angular_mrad.png

# ---------------------------------------------------------------------------
# Laser pointing stability baseline (stability_laser/MAR_27)
# ---------------------------------------------------------------------------
