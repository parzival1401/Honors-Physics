donut-setup-creation.png              EOD_exp_4_relay system_2EOD_donut_creation.png

# ---------------------------------------------------------------------------
# Polarization dependence of the deflection sensitivity (apr10 dataset)
# ---------------------------------------------------------------------------
# Four graphs per drive channel. The split sources carry no serial suffix, and
# which crystal each channel drives is unresolved (see PROVENANCE.md), so the
# stable names use the channel only.
eod-polarization-hva1-radial.png      HVA1_polarization_radial.png
eod-polarization-hva1-cx.png          HVA1_polarization_cx.png
eod-polarization-hva1-cy.png          HVA1_polarization_cy.png
eod-polarization-hva1-mrad-per-kv.png HVA1_polarization_mrad_per_kV.png
eod-polarization-hva2-radial.png      HVA2_polarization_radial.png
eod-polarization-hva2-cx.png          HVA2_polarization_cx.png
eod-polarization-hva2-cy.png          HVA2_polarization_cy.png
eod-polarization-hva2-mrad-per-kv.png HVA2_polarization_mrad_per_kV.png

# ---------------------------------------------------------------------------
# Beam quality against drive voltage (mar_25 angle dataset)
# ---------------------------------------------------------------------------
# These four source names are generic — a bare ordinal and a metric. They are
# unique only because one source root holds them. If another dataset directory
# with the same naming is ever added to SOURCE_ROOTS, the newest-match rule
# will silently pick across datasets; rename at the source if that happens.
eod-quality-voltage-fwhm.png          1_fwhm.png
eod-quality-voltage-ellipticity.png   2_ellipticity.png
eod-quality-voltage-r2.png            3_r2.png
eod-quality-voltage-omega.png         4_omega.png
